# Export these variables before running make run. The API does not load .env files.
LISTEN_ADDRESS=127.0.0.1
PORT=8081
SERVICE_DATABASE_PATH=./data/service.db
FILE_STORAGE_DIR=./data/audio
MAX_AUDIO_BYTES=20971520
PROCESSING_TIMEOUT=10m
LOCALAI_BASE_URL=http://127.0.0.1:8080/v1
LOCALAI_API_KEY=
TRANSCRIPTION_MODEL=whisper-small
LLM_MODEL=qwen3-4b
TIMEZONE=Europe/Berlin
