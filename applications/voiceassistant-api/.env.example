# make run loads .env from this directory. Quote values containing spaces.
LISTEN_ADDRESS=127.0.0.1
PORT=8081
# Enable the Google Sheets API and grant the service account Editor access to this spreadsheet.
# Missing CRM Tasks and CRM Sales Visit Reports tabs are created automatically.
GOOGLE_SPREADSHEET_ID=
GOOGLE_CREDENTIALS_FILE=/absolute/path/to/service-account.json
MAX_AUDIO_BYTES=20971520
PROCESSING_TIMEOUT=10m
LOCALAI_BASE_URL=http://127.0.0.1:8080/v1
TRANSCRIPTION_MODEL=whisper-small
LLM_MODEL=qwen3-4b
TIMEZONE=Europe/Berlin
